  ml python/2.7-anaconda
  ml GCC/8.3.0
  ml MVAPICH2/2.3.3-GDR
  ml python/3.6
  ml PrgEnv-gnu cpe-cuda cudatoolkit python
  ml python cudatoolkit
  ml gcc
  ml fftw
  ml python/3.7.0-anaconda3-5.3.0
