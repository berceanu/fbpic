# Python virtual env
if [ -d "${HOME}/sw/karolina/gpu/venvs/synchrad" ]
then
  source ${HOME}/sw/karolina/gpu/venvs/synchrad/bin/activate
fi

# compiler environment hints
export CC=$(which gcc)
export CXX=$(which g++)
export FC=$(which gfortran)
export CUDACXX=$(which nvcc)
export CUDAHOSTCXX=${CXX}